{
  "name": "checkmensualidad",
  "version": "1.0.0",
  "description": "Consulta de membresías del gimnasio Fuerza Delta",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
